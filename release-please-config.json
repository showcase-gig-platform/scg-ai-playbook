{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "650e77baeaca0eb627ab8bda34e5d1aaa704357c",
  "packages": {
    ".": {
      "release-type": "simple",
      "component": "scg-ai-playbook",
      "exclude-paths": ["plugins/scg-ai-playbook"],
      "extra-files": [
        {
          "type": "json",
          "path": ".cursor-plugin/marketplace.json",
          "jsonpath": "$.metadata.version"
        }
      ]
    },
    "plugins/scg-ai-playbook": {
      "release-type": "simple",
      "component": "agent-plugin",
      "extra-files": [
        {
          "type": "json",
          "path": "plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": ".claude-plugin/plugin.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
